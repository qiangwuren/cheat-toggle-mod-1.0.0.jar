{
	"schemaVersion": 1,
	"id": "cheattoggle",
	"version": "${version}",
	"name": "修复26.2极限模式无法秒开仙人的Bug",
	"description": "修复 26.2 版本极限模式下无法直接开启作弊/修改难度的问题，无需通过 NBT 修改器",
	"authors": [
		"chi"
	],
	"contact": {
		"homepage": "https://github.com/chi",
		"sources": "https://github.com/chi/cheat-toggle-mod"
	},
	"license": "MIT",
	"icon": "assets/cheattoggle/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.cheattoggle.CheatToggleMod"
		],
		"client": [
			"com.cheattoggle.client.CheatToggleModClient"
		]
	},
	"mixins": [
		"cheattoggle.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version_min}",
		"fabric-api": "*"
	}
}
